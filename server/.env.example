# Server-only environment variables — copy to ../.env (root) or server/.env
#
# SECURITY: these keys are secrets. They must NEVER be prefixed with VITE_ —
# any VITE_-prefixed variable is inlined into the public browser bundle.
# Never commit a filled-in .env file (see root .gitignore).

# AI providers (pick at least one)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Supabase service role key — server-side only, bypasses row-level security
SUPABASE_SERVICE_KEY=

# Port the API server listens on (defaults to 3001)
PORT=3001
