# Client (browser) environment variables — copy to ../../.env (root) or client/.env
#
# SECURITY: only variables prefixed with VITE_ are inlined into the browser build and
# are therefore PUBLIC. Never prefix a server secret with VITE_.
# Server-only keys (must never be VITE_-prefixed or committed):
#   GEMINI_API_KEY, GROQ_API_KEY, DEEPSEEK_API_KEY, SUPABASE_SERVICE_KEY
#   (server code lives in server/ and reads the root .env directly)

# Base URL of the API server. Empty = same-origin relative /api/* (local dev via vite proxy).
# In production set this to your deployed server origin, e.g. https://your-server.example.com
VITE_API_URL=

# Supabase project (public publishable key — safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox public token
VITE_MAPBOX_TOKEN=
